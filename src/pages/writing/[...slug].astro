---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, KIND_LABEL, readingMinutes, type Post } from '../../lib';
import { SITE } from '../../config';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: { post, newer: posts[i - 1], older: posts[i + 1] },
  }));
}

interface Props { post: Post; newer?: Post; older?: Post }
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const { title, description, date, updated, kind, tags, placeholder } = post.data;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  dateModified: (updated ?? date).toISOString(),
  author: { '@type': 'Person', name: SITE.author, url: Astro.site?.toString() },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).toString(),
  keywords: tags.join(', '),
};
---

<Base title={title} description={description} type="article" publishedTime={date} modifiedTime={updated}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleLd)} />
  <article class="wrap post">
    <header>
      <p class="back"><a href="/writing">← all writing</a></p>
      <div class="kicker">
        <span class={`hand kind ${kind}`}>{KIND_LABEL[kind]}</span>
        {placeholder && <span class="badge-placeholder">placeholder post, replace me</span>}
      </div>
      <h1>{title}</h1>
      <p class="desc">{description}</p>
      <p class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time> · {readingMinutes(post.body)} min read
        {updated && <> · updated <time datetime={updated.toISOString()}>{formatDate(updated)}</time></>}
      </p>
    </header>

    <div class="prose">
      <Content />
    </div>

    <footer class="end">
      <p class="sig hand">— Dani</p>
      {tags.length > 0 && (
        <ul class="tags" aria-label="Tags">{tags.map((t) => <li>#{t}</li>)}</ul>
      )}
      <nav class="pager" aria-label="More posts">
        {older ? <a class="paper-card" href={`/writing/${older.id}`} rel="prev"><span class="hand">older</span>{older.data.title}</a> : <span />}
        {newer && <a class="paper-card r" href={`/writing/${newer.id}`} rel="next"><span class="hand">newer</span>{newer.data.title}</a>}
      </nav>
    </footer>
  </article>
</Base>

<style>
  .post { max-width: calc(var(--measure) + 32px); padding-block: clamp(16px, 4vw, 40px) 20px; }
  .back { margin: 0 0 28px; font-style: italic; }
  .back a { text-decoration: none; color: var(--mute); }
  .back a:hover { color: var(--ink); }
  .kicker { display: flex; gap: 12px; align-items: center; flex-wrap: wrap; }
  .kind { font-size: 26px; line-height: 1; }
  .kind.code { color: var(--sage-ink); } .kind.life { color: var(--rose-ink); }
  h1 { font-weight: 400; font-size: clamp(36px, 5.4vw, 58px); line-height: 1.06; letter-spacing: -.02em; margin: 10px 0 16px; text-wrap: balance; }
  .desc { font-size: 21px; font-style: italic; color: var(--ink-soft); margin: 0 0 12px; }
  .meta { color: var(--mute); font-size: 16px; margin: 0 0 36px; padding-bottom: 28px; border-bottom: 1.5px dashed var(--line); }

  .prose { font-size: 20px; line-height: 1.7; }
  .prose :global(h2) { font-family: var(--hand); font-size: 38px; font-weight: 700; line-height: 1.1; margin: 1.8em 0 .4em; }
  .prose :global(h3) { font-size: 24px; font-weight: 600; margin: 1.6em 0 .4em; }
  .prose :global(p), .prose :global(ul), .prose :global(ol) { margin: 0 0 1.1em; }
  .prose :global(li) { margin-bottom: .35em; }
  .prose :global(li::marker) { color: var(--ochre-ink); }
  .prose :global(blockquote) {
    margin: 1.6em 0; padding: 18px 22px; background: var(--card); position: relative;
    font-style: italic; transform: rotate(-.5deg);
    box-shadow: 0 14px 24px -18px rgba(60, 40, 20, .45);
  }
  .prose :global(blockquote p:last-child) { margin: 0; }
  .prose :global(code) { font-family: var(--mono); font-size: .82em; background: rgba(201, 138, 43, .16); padding: .12em .35em; border-radius: 4px; }
  .prose :global(pre) {
    font-size: 15px; line-height: 1.6; padding: 18px 20px; border-radius: 4px; overflow-x: auto;
    border: 1.5px solid var(--line); margin: 1.4em 0;
  }
  .prose :global(code), .prose :global(pre) { font-variant-ligatures: none; }
  .prose :global(pre code) { background: none; padding: 0; font-size: inherit; }
  .prose :global(img) { display: block; margin: 1.6em auto; box-shadow: 0 14px 24px -16px rgba(60, 40, 20, .45); }
  .prose :global(hr) { border: 0; height: 12px; margin: 2.4em auto; width: 140px; background: var(--squiggle) center / 100% 100% no-repeat; }
  .prose :global(a) { text-decoration-thickness: 2px; }
  .prose :global(table) { border-collapse: collapse; width: 100%; font-size: 17px; display: block; overflow-x: auto; }
  .prose :global(th), .prose :global(td) { border-bottom: 1.5px dashed var(--line); padding: 8px 10px; text-align: left; }

  .end { margin-top: 48px; padding-top: 20px; border-top: 1.5px dashed var(--line); }
  .sig { font-size: 32px; margin: 0 0 12px; }
  .tags { display: flex; flex-wrap: wrap; gap: 10px; list-style: none; padding: 0; margin: 0 0 32px; color: var(--mute); font-style: italic; }
  .pager { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .pager a { display: block; padding: 18px 20px; text-decoration: none; font-weight: 600; line-height: 1.3; transform: rotate(-.8deg); transition: transform .3s; }
  .pager a.r { text-align: right; transform: rotate(.8deg); }
  .pager a:hover { transform: rotate(0) translateY(-4px); color: var(--ink); }
  .pager .hand { display: block; font-weight: 400; font-size: 22px; color: var(--mute); }
  @media (max-width: 640px) { .pager { grid-template-columns: 1fr; } .prose { font-size: 19px; } }
</style>
